{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": {"left": 30, "right": 5, "top": 5, "bottom": 5},
  "title": {
    "text": {"expr": "upper('When School\u2019s Out')"},
    "subtitle": "Average Weekday Trips by Mode: School Term vs. Holidays (Melbourne, Past Year)",
    "anchor": "middle",
    "frame": "bounds"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ssoh0013/3179-dv2/refs/heads/main/dataset/mel_average_patronage.csv",
    "format": {"parse": {"Year": "number", "Month": "number", "Pax_daily": "number"}}
  },
  "transform": [
    {"calculate": "datum.Year * 12 + datum.Month", "as": "month_index"},
    {"joinaggregate": [{"op": "max", "field": "month_index", "as": "latest_month"}]},
    {"filter": "datum.month_index > datum.latest_month - 12"},
    {"filter": {"field": "Day_type", "oneOf": ["Normal Weekday", "School Holiday Weekday"]}},
    {
      "aggregate": [{"op": "mean", "field": "Pax_daily", "as": "Avg_daily"}],
      "groupby": ["Mode", "Day_type"]
    },
    {"pivot": "Day_type", "value": "Avg_daily", "groupby": ["Mode"]},
    {"calculate": "datum['Normal Weekday']", "as": "Term"},
    {"calculate": "datum['School Holiday Weekday']", "as": "Holiday"},
    {"calculate": "datum.Holiday / datum.Term", "as": "Holiday_ratio"},
    {
      "calculate": "{'MetroTrain': 'Metro train', 'Tram': 'Tram', 'MetroBus': 'Metro bus', 'RegionalTrain': 'Regional train', 'RegionalBus': 'Regional bus'}[datum.Mode]",
      "as": "Mode_label"
    },
    {"calculate": "replace(format(datum.Term, '.3~s'), 'k', 'K')", "as": "Term_label"},
    {"calculate": "replace(format(datum.Holiday, '.3~s'), 'k', 'K') + '  (' + format(datum.Holiday_ratio, '.0%') + ' of term-time)'", "as": "Holiday_label"}
  ],
  "spacing": 0,
  "hconcat": [
    {
      "width": 230,
      "height": 220,
      "title": {"text": "Term-time weekday", "fontSize": 13},
      "encoding": {
        "y": {"field": "Mode_label", "type": "nominal", "axis": null, "sort": ["Metro train", "Tram", "Metro bus", "Regional train", "Regional bus"]},
        "x": {
          "field": "Term",
          "type": "quantitative",
          "sort": "descending",
          "scale": {"domain": [0, 650000]},
          "axis": {"format": "~s", "title": null, "grid": false, "labelExpr": "replace(datum.label, 'k', 'K')"}
        },
        "tooltip": [
          {"field": "Mode_label", "title": "Mode"},
          {"field": "Term", "title": "Term-time weekday (avg trips/day)", "format": ",.0f"}
        ]
      },
      "layer": [
        {"mark": {"type": "bar", "color": "#a8bdfa", "cornerRadius": 2}},
        {
          "mark": {"type": "text", "align": "right", "dx": -4, "fontSize": 11, "fontStyle": "italic", "color": "#333333"},
          "encoding": {"text": {"field": "Term_label"}}
        }
      ]
    },
    {
      "width": 110,
      "height": 220,
      "view": {"stroke": null},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold"},
      "encoding": {
        "y": {"field": "Mode_label", "type": "nominal", "axis": null, "sort": ["Metro train", "Tram", "Metro bus", "Regional train", "Regional bus"]},
        "text": {"field": "Mode_label"}
      }
    },
    {
      "width": 230,
      "height": 220,
      "title": {"text": "School-holiday weekday", "fontSize": 13},
      "encoding": {
        "y": {"field": "Mode_label", "type": "nominal", "axis": null, "sort": ["Metro train", "Tram", "Metro bus", "Regional train", "Regional bus"]},
        "x": {
          "field": "Holiday",
          "type": "quantitative",
          "scale": {"domain": [0, 650000]},
          "axis": {"format": "~s", "title": null, "grid": false, "labelExpr": "replace(datum.label, 'k', 'K')"}
        },
        "tooltip": [
          {"field": "Mode_label", "title": "Mode"},
          {"field": "Holiday", "title": "School-holiday weekday (avg trips/day)", "format": ",.0f"},
          {"field": "Holiday_ratio", "title": "Share of term time", "format": ".0%"}
        ]
      },
      "layer": [
        {"mark": {"type": "bar", "color": "#FFD3E0", "cornerRadius": 2}},
        {
          "mark": {"type": "bar", "fill": null, "stroke": "#7A92DD", "strokeWidth": 1.2, "strokeDash": [4, 3], "cornerRadius": 2},
          "encoding": {"x": {"field": "Term", "type": "quantitative"}}
        },
        {
          "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 11, "fontStyle": "italic", "color": "#333333"},
          "encoding": {
            "text": {"field": "Holiday_label"},
            "x": {"field": "Term", "type": "quantitative"}
          }
        }
      ]
    }
  ],
  "config": {"view": {"stroke": null}}
}