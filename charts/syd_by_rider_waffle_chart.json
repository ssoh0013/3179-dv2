{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {"expr": "upper('Who Rides What in Sydney')"},
    "subtitle": [
      "Each square = 1% of Adult, Child/Student and Senior trips",
      "on that mode, latest 12 months"
    ],
    "anchor": "middle",
    "frame": "bounds"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ssoh0013/3179-dv2/refs/heads/main/dataset/syd_bymode.csv",
    "format": {
      "parse": {
          "Year_Month": "string",
          "Trip": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "toNumber(substring(datum.Year_Month, 0, 4)) * 12 + toNumber(substring(datum.Year_Month, 5, 7))",
      "as": "month_index"
    },
    {
      "joinaggregate": [{"op": "max", "field": "month_index",
      "as": "latest_month"}]
    },
    {
      "filter": "datum.month_index > datum.latest_month - 12"
    },
    {
      "filter": {"field": "Card_group",
      "oneOf": ["Adult", "Child/Student", "Senior"]}
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Trip",
          "as": "Trips"
        }
      ],
      "groupby": ["Mode", "Card_group"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Trips",
          "as": "Mode_total"
        }
      ],
      "groupby": ["Mode"]
    },
    {
      "calculate": "datum.Trips / datum.Mode_total * 100",
      "as": "Percent"
    },
    {
      "calculate": "indexof(['Adult', 'Child/Student', 'Senior'], datum.Card_group)",
      "as": "group_order"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "Percent",
          "as": "Cumulative"
        }
      ],
      "sort": [
        {
          "field": "group_order"
        }
      ],
      "groupby": ["Mode"],
      "frame": [null, 0]
    },
    {
      "calculate": "round(datum.Cumulative - datum.Percent)",
      "as": "square_start"
    },
    {
      "calculate": "round(datum.Cumulative)",
      "as": "square_end"
    },
    {
      "calculate": "sequence(datum.square_start, datum.square_end)",
      "as": "square_id"
    },
    {
      "flatten": ["square_id"]
    },
    {
      "calculate": "datum.square_id % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.square_id / 10)",
      "as": "row"
    }
  ],
  "facet": {
    "column": {
      "field": "Mode",
      "type": "nominal",
      "sort": ["Bus", "Metro", "Ferry"],
      "title": null,
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": "bold"
      }
    }
  },
  "spec": {
    "width": 150,
    "height": 150,
    "mark": {
      "type": "square",
      "size": 150,
      "opacity": 1,
      "strokeWidth": 1
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "sort": "descending"
      },
      "color": {
        "field": "Card_group",
        "type": "nominal",
        "title": "Rider group",
        "scale": {
          "domain": ["Adult", "Child/Student", "Senior"],
          "range": ["#A9BDFA", "#FCD2D5", "#B6DFFB"]
        },
        "legend": {
          "orient": "bottom",
          "columns": 3
        }
      },
      "stroke": {
        "field": "Card_group",
        "type": "nominal",
        "scale": {
          "domain": ["Adult", "Child/Student", "Senior"],
          "range": ["#7A92DD", "#E8A3A9", "#7FBDE8"]
        },
        "legend": null
      },
      "tooltip": [
          {"field": "Mode"},
          {"field": "Card_group", "title": "Rider group"},
          {"field": "Percent", "title": "Share of trips (%)", "format": ".1f"}
      ]
    }
  },
  "config": {"view": {"stroke": null}}
}