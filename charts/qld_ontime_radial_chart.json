{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "upper('On Time in Queensland, 2025–26')"
    },
    "subtitle": [
      "Share of services running on time, Jul 2025 – Jun 2026 (full arc = 100%)",
      "Train: peak hours only · Bus: all day · Tram: all day"
    ]
  },
  "width": 360,
  "height": 360,
  "data": {
    "url": "https://raw.githubusercontent.com/ssoh0013/3179-dv2/refs/heads/main/dataset/qld_ontime_reliability.csv",
    "format": {
      "parse": {
        "Year_Month": "date:'%b-%y'",
        "On_Time": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Year_Month >= datetime(2025, 6, 1) && datum.Year_Month <= datetime(2026, 5, 1)"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "On_Time",
          "as": "Avg_on_time"
        }
      ],
      "groupby": [
        "Mode"
      ]
    },
    {
      "calculate": "indexof(['Bus', 'Train', 'Tram'], datum.Mode)",
      "as": "ring"
    },
    {
      "calculate": "70 + datum.ring * 38",
      "as": "r_inner"
    },
    {
      "calculate": "datum.r_inner + 28",
      "as": "r_outer"
    },
    {
      "calculate": "0",
      "as": "angle_start"
    },
    {
      "calculate": "1.5 * PI",
      "as": "angle_full"
    },
    {
      "calculate": "datum.Avg_on_time * 1.5 * PI",
      "as": "angle_end"
    },
    {
      "calculate": "datum.Mode + (datum.Mode == 'Train' ? ' (peak)' : '') + '  ' + format(datum.Avg_on_time, '.0%')",
      "as": "label"
    },
    {
      "calculate": "'1 in ' + round(1 / (1 - datum.Avg_on_time)) + ' ' + (datum.Mode == 'Bus' ? 'buses' : lower(datum.Mode) + 's') + ' late'",
      "as": "late_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "color": "#eeeeee"
      },
      "encoding": {
        "theta": {
          "field": "angle_start",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "angle_full"
        },
        "radius": {
          "field": "r_inner",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "r_outer"
        }
      }
    },
    {
      "mark": {
        "type": "arc",
        "cornerRadius": 4,
        "strokeWidth": 1.5
      },
      "encoding": {
        "theta": {
          "field": "angle_start",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "angle_end"
        },
        "radius": {
          "field": "r_inner",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "r_outer"
        },
        "color": {
          "field": "Mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Train",
              "Bus",
              "Tram"
            ],
            "range": [
              "#A9BDFA",
              "#FCD2D5",
              "#B6DFFB"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Mode"
          },
          {
            "field": "Avg_on_time",
            "title": "On time (average)",
            "format": ".1%"
          }
        ],
        "stroke": {
          "field": "Mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Train",
              "Bus",
              "Tram"
            ],
            "range": [
              "#7A92DD",
              "#E8A3A9",
              "#7FBDE8"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "pct": 0.9
          },
          {
            "pct": 0.95
          },
          {
            "pct": 1.0
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.pct * 1.5 * PI",
          "as": "a"
        },
        {
          "calculate": "datum.a + 0.006",
          "as": "a2"
        },
        {
          "calculate": "format(datum.pct, '.0%')",
          "as": "tick_label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "arc",
            "color": "#aaaaaa"
          },
          "encoding": {
            "theta": {
              "field": "a",
              "type": "quantitative",
              "scale": null
            },
            "theta2": {
              "field": "a2"
            },
            "radius": {
              "value": 66
            },
            "radius2": {
              "value": 178
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "color": "#666666"
          },
          "encoding": {
            "theta": {
              "field": "a",
              "type": "quantitative",
              "scale": null
            },
            "radius": {
              "value": 190
            },
            "text": {
              "field": "tick_label"
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "theta": {
          "field": "angle_start",
          "type": "quantitative",
          "scale": null
        },
        "radius": {
          "field": "r_mid",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "label"
        }
      },
      "transform": [
        {
          "calculate": "(datum.r_inner + datum.r_outer) / 2",
          "as": "r_mid"
        }
      ]
    },
    {
      "transform": [
        {
          "calculate": "datum.Mode == 'Bus' ? PI : 0",
          "as": "c_theta"
        },
        {
          "calculate": "datum.Mode == 'Train' ? 0 : 16",
          "as": "c_radius"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "calculate": "180 - datum.c_radius * cos(datum.c_theta)",
              "as": "py"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "M-1,-0.16H1V0.16H-1Z",
            "size": 9000,
            "filled": true,
            "opacity": 1,
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {
              "value": 180
            },
            "y": {
              "field": "py",
              "type": "quantitative",
              "scale": null
            },
            "fill": {
              "field": "Mode",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Train",
                  "Bus",
                  "Tram"
                ],
                "range": [
                  "#A9BDFA",
                  "#FCD2D5",
                  "#B6DFFB"
                ]
              },
              "legend": null
            },
            "stroke": {
              "field": "Mode",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Train",
                  "Bus",
                  "Tram"
                ],
                "range": [
                  "#7A92DD",
                  "#E8A3A9",
                  "#7FBDE8"
                ]
              },
              "legend": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontStyle": "italic",
            "color": "#555555"
          },
          "encoding": {
            "theta": {
              "field": "c_theta",
              "type": "quantitative",
              "scale": null
            },
            "radius": {
              "field": "c_radius",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "late_label"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}