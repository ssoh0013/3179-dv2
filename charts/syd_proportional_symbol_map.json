      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Area"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 11.5,
            "fontStyle": "italic",
            "color": "#666666",
            "clip": true
          }
        }
      ]
    },
    {
      "mark": {
        "type": "circle",
        "strokeWidth": 1,
        "clip": true
      },
      "data": {
        "url": "https://raw.githubusercontent.com/ssoh0013/3179-dv2/refs/heads/main/dataset/nsw_station_entries_exits.csv",
        "format": {
          "parse": {
            "Year": "string",
            "Entries_AM": "number",
            "Exits_AM": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Year == '2023'"
        },
        {
          "filter": "isValid(datum.Entries_AM) && isValid(datum.Exits_AM)"
        },
        {
          "calculate": "datum.Exits_AM - datum.Entries_AM",
          "as": "Net"
        },
        {
          "calculate": "abs(datum.Net)",
          "as": "Net_size"
        },
        {
          "calculate": "datum.Net > 0 ? 'More people arrive' : 'More people leave'",
          "as": "Direction"
        },
        {
          "lookup": "Station",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/ssoh0013/3179-dv2/refs/heads/main/dataset/nsw_station_location.csv"
            },
            "key": "Station",
            "fields": [
              "Latitude",
              "Longitude"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.Latitude)",
          "as": "Latitude"
        },
        {
          "calculate": "toNumber(datum.Longitude)",
          "as": "Longitude"
        },
        {
          "filter": "isValid(datum.Latitude)"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "nearest": true,
            "fields": [
              "Station"
            ]
          }
        }
      ],
      "encoding": {
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Net_size",
          "type": "quantitative",
          "title": "Arrivals minus departures",
          "scale": {
            "rangeMax": 2500
          },
          "legend": {
            "values": [
              1000,
              10000,
              30000
            ],
            "format": ",.0f",
            "symbolFillColor": "#F9F5F1",
            "symbolStrokeColor": "#eadccd",
            "titleLimit": 250
          }
        },
        "color": {
          "field": "Direction",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "More people arrive",
              "More people leave"
            ],
            "range": [
              "#7A92DD",
              "#FFD3E0"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 618,
            "legendY": 128
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 0.65
          },
          "value": 0.35
        },
        "order": {
          "field": "Net_size",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "Station"
          },
          {
            "field": "Exits_AM",
            "title": "Arriving (exits, AM)",
            "format": ","
          },
          {
            "field": "Entries_AM",
            "title": "Leaving (entries, AM)",
            "format": ","
          },
          {
            "field": "Net",
            "title": "Arriving \u2212 leaving",
            "format": "+,"
          }
        ],
        "stroke": {
          "condition": [
            {
              "test": "indexof(['Wynyard Station', 'Town Hall Station', 'Central Station', 'North Sydney Station', 'Parramatta Station'], datum.Station) >= 0",
              "value": "#2F4A9E"
            },
            {
              "test": "indexof(['Hurstville Station', 'Epping Station', 'Strathfield Station'], datum.Station) >= 0",
              "value": "#B8436B"
            }
          ],
          "field": "Direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "More people arrive",
              "More people leave"
            ],
            "range": [
              "#5670C0",
              "#E8A3B8"
            ]
          },
          "title": null
        },
        "strokeWidth": {
          "condition": {
            "test": "indexof(['Wynyard Station', 'Town Hall Station', 'Central Station', 'North Sydney Station', 'Parramatta Station'], datum.Station) >= 0 || indexof(['Hurstville Station', 'Epping Station', 'Strathfield Station'], datum.Station) >= 0",
            "value": 2.5
          },
          "value": 1
        }
      }
    },
    {
